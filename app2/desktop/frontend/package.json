{
  "name": "@lyra/desktop-app2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src --deny-warnings",
    "format:check": "prettier --check src index.html vite.config.ts tsconfig.json",
    "test": "vitest run",
    "contract:check": "cd ../../runtime && GOWORK=off go run ./cmd/contractgen -out contract -check",
    "build": "tsc --noEmit && vite build",
    "check": "npm run contract:check && npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
    "@lyra/runtime-contract": "file:../../runtime/contract/typescript",
    "@tanstack/react-query": "^5.101.4",
    "@wailsio/runtime": "3.0.0-beta.12",
    "dompurify": "^3.3.1",
    "katex": "^0.16.45",
    "lucide-react": "^1.28.0",
    "mermaid": "^11.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-cjk-friendly": "^2.0.1",
    "remark-cjk-friendly-gfm-strikethrough": "^2.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^3.23.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "happy-dom": "^20.11.0",
    "oxlint": "^1.76.0",
    "prettier": "^3.9.0",
    "typescript": "^6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.0"
  }
}
