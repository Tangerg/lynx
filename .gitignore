.idea
.vscode
.opencode/
.DS_Store

# Claude permission decisions are machine-local and accumulate absolute paths.
.claude/settings.local.json

# ScopeApp local config (holds API keys) — keep config.example.yaml only.
app/runtime/config/config.yaml

# ScopeApp dev binary (built via `go build -o scopeapp ./cmd/scopeapp`).
app/runtime/scopeapp

# ScopeApp dev-server runtime artifacts (written by `make restart` / `make start`).
app/runtime/scopeapp.log
app/runtime/scopeapp.pid

# ScopeApp runtime-generated knowledge (written to cwd when serving from app/runtime/).
app/runtime/SCOPEAPP.md
