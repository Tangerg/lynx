# Wails build output (v3 puts the binary and the .app bundle here)
build/bin

# The CLI's task-runner cache
.task/

# Packaging assets for platforms this project does not build. `wails3 update
# build-assets` writes every platform it supports whether or not there is a target for
# it, and deleting them just means they come back on the next run — so they are ignored
# rather than fought. Only darwin is wired in the Taskfile; adding a platform means
# adding its include, and its assets will already be here.
build/ios/
build/linux/
build/windows/

# Node + Vite
node_modules
frontend/dist

# macOS / editor noise
.DS_Store
*.log
.idea/
.vscode/

# Local plugin sideload tree (loaded at runtime, not source)
.lyra/

# Test + tooling caches
.cache/
coverage/
