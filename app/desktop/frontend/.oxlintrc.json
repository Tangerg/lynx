{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "oxc", "import", "jsx-a11y", "promise", "vitest"],
  "rules": {
    // Fires on `[...map.values()]`, which is how a Map is read into an array —
    // there is no non-spread spelling of that, so the rule has nothing to offer here.
    "unicorn/no-useless-spread": "off",
    "react-hooks/exhaustive-deps": "error",
    "react-hooks/rules-of-hooks": "error",
    // React Compiler is not enabled. TanStack Virtual deliberately returns
    // dynamic measurement callbacks; the compiler-only incompatibility warning
    // does not represent a runtime correctness or memoization contract here.
    "react/incompatible-library": "off",
    // Our mocks are typed by the port interface they stand in for, so the type
    // parameter would restate what the assignment target already fixes.
    "vitest/require-mock-type-parameters": "off",
    // Fired three times in the tree, on three correct roles: a resize handle
    // (`separator`), and the mention picker's `listbox` / `option`. The rule maps a
    // role to "the tag you should have used", which has no answer for a composite
    // ARIA widget — a floating rich list cannot be a `<select>`, and `<option>` is
    // only legal inside one. A rule that is wrong every time it fires teaches
    // people to suppress reflexively.
    "jsx-a11y/prefer-tag-over-role": "off",
    // The dock / session-navigation suites assert through `expect*` helpers so a
    // multi-step scenario reads as prose. Naming the convention once beats seven
    // line suppressions that each restate it.
    "vitest/expect-expect": [
      "error",
      { "assertFunctionNames": ["expect", "expectTypeOf", "assert", "assertType", "expect*"] }
    ]
  },
  "ignorePatterns": ["wailsjs/**", "dist/**", "node_modules/**", "sample-plugins/**"]
}
