{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "visual/main.tsx",
    "visual/**/*.visual.spec.ts",
    "src/plugins/**/public/**/*.{ts,tsx}",
    "src/plugins/builtin/chat/message/ui/index.ts",
    "src/plugins/builtin/theme/kit/defineColorThemePlugin.ts",
    "src/plugins/sdk/host.ts",
    "src/rpc/index.ts",
    "src/ui/atoms/index.ts"
  ],
  "ignoreExportsUsedInFile": true,
  "ignore": ["sample-plugins/**", "src/rpc/wire.generated.ts"],
  "ignoreDependencies": ["husky", "lint-staged", "@commitlint/cli"]
}
