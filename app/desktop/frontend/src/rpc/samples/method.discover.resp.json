{
  "protocolVersion": "2026-08-21",
  "serverInfo": {
    "instanceId": "runtime_019c765b-2f8f-7e36-a2b4-31cb11f48d10",
    "name": "lyra",
    "version": "0.1.0",
    "defaultWorkspace": { "path": "/Users/dev/project" },
    "home": "/Users/dev/.lyra"
  },
  "capabilities": {
    "runEvents": [
      "segment.started",
      "segment.progress",
      "segment.finished",
      "item.started",
      "item.delta",
      "item.completed",
      "state.snapshot"
    ],
    "runtimeTopics": [
      "files.changed",
      "skills.changed",
      "mcp.changed",
      "schedules.changed",
      "sessions.changed",
      "runs.changed",
      "state.changed",
      "goals.changed",
      "interrupts.changed"
    ],
    "stateSnapshots": [
      {
        "key": "plan",
        "recoveryMethod": "plan.get",
        "scope": "session",
        "writer": "rootRun"
      }
    ],
    "streamingMethods": ["runs.start", "runs.resume", "runs.subscribe", "runtime.subscribe"],
    "features": {
      "reasoning": {
        "enabled": true,
        "clientOptIn": false,
        "requiredByRunProtocol": false
      },
      "mcp": {
        "enabled": true,
        "clientOptIn": false,
        "requiredByRunProtocol": false
      },
      "multimodal": {
        "enabled": true,
        "clientOptIn": false,
        "requiredByRunProtocol": false
      },
      "git": {
        "enabled": true,
        "clientOptIn": false,
        "requiredByRunProtocol": false
      },
      "fileWatch": {
        "enabled": true,
        "clientOptIn": false,
        "requiredByRunProtocol": false
      },
      "checkpoints": {
        "enabled": true,
        "clientOptIn": false,
        "requiredByRunProtocol": false
      },
      "lsp": {
        "enabled": true,
        "clientOptIn": false,
        "requiredByRunProtocol": false
      },
      "subagents": {
        "enabled": false,
        "clientOptIn": true,
        "requiredByRunProtocol": true
      },
      "skills": {
        "enabled": true,
        "clientOptIn": false,
        "requiredByRunProtocol": false
      },
      "sessionExport": {
        "enabled": true,
        "clientOptIn": false,
        "requiredByRunProtocol": false
      },
      "knowledge": {
        "enabled": true,
        "clientOptIn": false,
        "requiredByRunProtocol": false
      },
      "relocate": {
        "enabled": true,
        "clientOptIn": false,
        "requiredByRunProtocol": false
      },
      "plan": {
        "enabled": true,
        "clientOptIn": false,
        "requiredByRunProtocol": false
      },
      "compaction": {
        "enabled": true,
        "clientOptIn": false,
        "requiredByRunProtocol": false
      }
    },
    "limits": {
      "idempotency": {
        "namespace": "idp_0123456789abcdef0123456789abcdef",
        "retentionSeconds": 86400
      },
      "runReplay": {
        "scope": "runtimeInstanceRootSegment",
        "maxEvents": 2048,
        "maxBytes": 16777216
      },
      "mcpAuthorizationAttempts": {
        "retentionSeconds": 600
      },
      "runtimeSubscription": {
        "maxTopics": 32,
        "maxWatches": 32
      }
    }
  }
}
